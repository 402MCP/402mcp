{
  "name": "402mcp-org",
  "version": "1.0.0",
  "private": true,
  "description": "The open registry for agentic commerce & HTTP 402 payment infrastructure.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:agents": "node scripts/verify-agent-endpoints.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify": "npm run verify:agents && npm run verify:seo",
    "cf:build": "npm run build:package && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "build:package": "node scripts/build-package.mjs",
    "test:unit": "esbuild tests/decoders.test.ts --bundle --platform=node --format=esm --outfile=.test-build/decoders.test.mjs --log-level=warning --tsconfig=tsconfig.json && node .test-build/decoders.test.mjs",
    "verify:stdio": "node scripts/verify-stdio.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "wrangler": "^4.136.0"
  }
}
